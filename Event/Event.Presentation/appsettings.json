{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5442;Database=events;Username=postgres;Password=postgres",
    "Redis": "redis:6379,password=your_password,connectTimeout=5000,syncTimeout=5000,abortOnConnectFail=false"
  },
  "JwtSettings": {
    "SecretKey": "your-very-long-secret-key-at-least-32-characters-long-here",
    "Issuer": "WebApiTamakulov",
    "Audience": "WebApiTamakulovUsers",
    "ExpiryMinutes": 15
  },
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092",
    "ConsumerGroup": "events-service-group"
  }
}
  