{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5443;Database=bookings;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "your-very-long-secret-key-at-least-32-characters-long-here",
    "Issuer": "WebApiTamakulov",
    "Audience": "WebApiTamakulovUsers",
    "ExpiryMinutes": 15
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },

  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
  